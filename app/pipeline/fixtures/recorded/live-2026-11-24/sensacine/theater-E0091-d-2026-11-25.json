s trayectorias de los personajes entran en contacto directo con una c\u00e9lebre creaci\u00f3n. Se trata concretamente de una de las \u00faltimas obras dram\u00e1ticas que dej\u00f3 inacabadas Federico Garc\u00eda Lorca. A trav\u00e9s de este eje literario, el argumento explora el impacto que las pasiones ejercen a lo largo de las generaciones. Las b\u00fasquedas emocionales de cada uno de ellos convergen en un relato centrado en la memoria, la identidad y los sentimientos. De este modo, la trama teje un entramado donde el legado cultural y el sufrimiento marcan de forma definitiva sus destinos."}]}]},"__typename":"Movie","internalId":1000024810,"id":"TW92aWU6MTAwMDAyNDgxMA==","poster":{"__typename":"InternalImage","id":"SW1hZ2U6OTAwMjEwMjM0Ng==","internalId":9002102346,"url":"https:\/\/es.web.img3.acsta.net\/img\/50\/36\/503680a28350a667b4b542fc43e21fce.jpg","path":"\/img\/50\/36\/503680a28350a667b4b542fc43e21fce.jpg"},"title":"La Bola Negra","originalTitle":"La Bola Negra","type":"FEATURE_FILM","runtime":"2h 40min","genres":[{"id":13008,"translate":"Drama","tag":"DRAMA"}],"languages":["SPANISH"],"data":{"__typename":"MovieData","seo":{"__typename":"Seo","browsable":true,"title":null},"productionYear":2026,"rules":{"rating":{"has_warning_message":false,"has_mandatory_review":false}}},"stats":{"userRating":{"score":3.93,"count":215},"userReview":{"count":59},"pressReview":{"score":3.67,"count":9},"metric":{"hits":273058,"sessions":186457},"wantToSeeCount":95},"editorialReviews":[{"rating":4.5}],"releases":[{"__typename":"MovieRelease","releaseDate":{"__typename":"PartialDate","date":"2026-09-25","precision":"day"},"name":"Released","certificate":{"__typename":"Certificate","code":"16","label":"Pelicula no recomendada a menores de 16"},"advice":null,"companyLimitation":null,"releaseTags":{"tagTypes":["THEATER"],"tagFlags":null},"visaNumber":null}],"credits":[{"person":{"__typename":"Person","internalId":401086,"lastName":"Calvo","firstName":"Javier","seo":{"__typenam