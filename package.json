{
  "name": "barcelona-movie-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && TZ=Europe/Madrid vite build && TZ=Europe/Madrid vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && TZ=Europe/Madrid node scripts/render.mjs",
    "export-data": "python3 scripts/export_listings.py",
    "favicons": "node scripts/generate-favicons.mjs",
    "refresh-cache": "python3 scripts/refresh_cache.py",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "~11.2.0",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3"
  }
}
