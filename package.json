{
  "name": "barcelona-movie-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && TZ=Europe/Madrid vite build && TZ=Europe/Madrid vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && TZ=Europe/Madrid node scripts/render.mjs",
    "export-data": "python3 scripts/export_listings.py",
    "favicons": "node scripts/generate-favicons.mjs",
    "refresh-cache": "python3 scripts/refresh_cache.py",
    "legacy:typecheck": "tsc -b",
    "legacy:lint": "eslint src",
    "legacy:test": "vitest",
    "legacy:test:run": "vitest run",
    "legacy:test:coverage": "vitest run --coverage",
    "legacy:e2e": "playwright test",
    "typecheck": "tsc -p app/shared && tsc -p app/domain && tsc -p app/pipeline && tsc -p app/render && tsc -p app/client && tsc -p app/fixture && tsc -p app/lint && tsc -p app/e2e && tsc -p app",
    "check": "npm run typecheck && eslint -c eslint.app.config.js app && stylelint \"app/**/*.css\" --allow-empty-input && depcruise app --config .dependency-cruiser.cjs && knip && npm run format:check",
    "format": "prettier --write app eslint.app.config.js .dependency-cruiser.cjs knip.json stylelint.config.mjs",
    "format:check": "prettier --check app eslint.app.config.js .dependency-cruiser.cjs knip.json stylelint.config.mjs",
    "test": "vitest run --config app/vitest.config.ts",
    "fixture": "tsx app/fixture/write.ts",
    "e2e": "playwright test -c app/e2e/playwright.config.ts",
    "shots": "playwright test -c app/e2e/tools.config.ts --project=shots",
    "budgets": "playwright test -c app/e2e/tools.config.ts --project=budgets"
  },
  "dependencies": {
    "preact": "~11.2.0",
    "preact-render-to-string": "^6.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.3",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.11.0",
    "html-validate": "^11.21.1",
    "jsdom": "^31.0.0",
    "knip": "^6.48.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
