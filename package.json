{
  "name": "barcelona-movie-database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && TZ=Europe/Madrid vite build && TZ=Europe/Madrid vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && TZ=Europe/Madrid node scripts/render.mjs",
    "export-data": "python3 scripts/export_listings.py",
    "favicons": "./scripts/generate-favicons.sh",
    "refresh-cache": "python3 scripts/refresh_cache.py",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "~10.29.8",
    "preact-render-to-string": "^6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.2"
  }
}
